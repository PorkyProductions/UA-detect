{
  "author": "PorkyProductions",
  "bugs": {
    "url": "https://github.com/PorkyProductions/UA-detect/issues"
  },
  "contributors": [
    "Tristan Winata"
  ],
  "dependencies": {
    "typescript": "^4.9.4"
  },
  "description": "The dead-simple way of interacting with the navigator API",
  "devDependencies": {
    "@types/jest": "^29.4.0",
    "@types/node": "^18.11.18",
    "@typescript-eslint/eslint-plugin": "^5.49.0",
    "@typescript-eslint/parser": "^5.49.0",
    "eslint": "^8.32.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "jest": "^29.4.1",
    "jest-environment-jsdom": "^29.4.1"
  },
  "displayName": "UADetect",
  "engines": {
    "node": ">= 14",
    "vscode": "^1.60.0"
  },
  "files": [
    "./dist/**/*.js",
    "./dist/**/*.js.map",
    "./dist/types/**/*.d.ts",
    "./dist/types/**/*.d.ts.map"
  ],
  "homepage": "https://porkyproductions.github.io/UA-detect/",
  "keywords": [
    "User",
    "Agent",
    "User",
    "Agent",
    "serve",
    "detect",
    "browser",
    "mobile",
    "desktop",
    "UADetect",
    "ua-detect",
    "navigator",
    "browser",
    "online",
    "memory",
    "cookie",
    "device",
    "os",
    "os-version",
    "os-version-name",
    "os-version-number",
    "pdf",
    "webdriver",
    "logicalProcessors",
    "hardwareConcurrency"
  ],
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "maintainers": [
    "Ryan Mullin"
  ],
  "name": "uadetect",
  "publisher": "PorkyProductions",
  "qna": "https://github.com/PorkyProductions/UA-detect/discussions/categories/q-a",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PorkyProductions/UA-detect.git"
  },
  "scripts": {
    "test": "jest",
    "build": "npm run build-ts && npm run build-slim && npm run build-small && npm run types-small",
    "build-ts": "tsc -p tsconfig.json",
    "build-slim": "esbuild ./src/index.ts --bundle --minify --target=es2019 --outfile=./dist/slim/index.js ",
    "build-small": "esbuild ./src/index.ts --splitting --format=esm --target=es2019 --outdir=./dist/small/ ",
    "types-small": "tsc ./dist/small/index.js --allowJs --noEmit --declaration --declarationDir ./dist/small/types/",
    "publish": "npm publish",
    "lint": "eslint ./src/* --fix"
  },
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "version": "6.0.0-alpha-1"
}
