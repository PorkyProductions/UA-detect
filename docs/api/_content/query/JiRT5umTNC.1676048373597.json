nality, or testability of will generally be accepted."}]},{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"Open a PR and use the same guidelines as patching a bug"}]},{"type":"element","tag":"h4","props":{"id":"do-you-intend-to-add-a-new-feature-or-change-an-existing-one"},"children":[{"type":"element","tag":"strong","props":{},"children":[{"type":"text","value":"Do you intend to add a new feature or change an existing one?"}]}]},{"type":"element","tag":"ul","props":{},"children":[{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Start writing code."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Do not open an issue on GitHub until you have collected positive feedback from peers about the change. GitHub issues are primarily intended for bug reports and fixes."}]}]},{"type":"element","tag":"h4","props":{"id":"do-you-have-questions-about-the-source-code"},"children":[{"type":"element","tag":"strong","props":{},"children":[{"type":"text","value":"Do you have questions about the source code?"}]}]},{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"Feel free to contact the administrators of the project, and/or PorkyProductions"}]},{"type":"element","tag":"h4","props":{"id":"do-you-want-to-contribute-to-the-documentation"},"children":[{"type":"element","tag":"strong","props":{},"children":[{"type":"text","value":"Do you want to contribute to the documentation?"}]}]},{"type":"element","tag":"ul","props":{},"children":[{"type":"element","tag":"li","props":{},"children":[{"type":"text","value":"Open a PR and follow the same guidelines as stated above"}]}]},{"type":"element","tag":"h3","props":{"id":"step-3-submit-the-changes"},"children":[{"type":"text","value":"Step 3: Submit the changes"}]},{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"Submit your changes in the "},{"type":"element","tag":"code-inline","props":{},"children":[{"type":"tex