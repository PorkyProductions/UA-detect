{"_path":"/community/contrib","_dir":"community","_draft":false,"_partial":false,"_locale":"","_empty":false,"title":"Contribution Guidelines","description":"","navigation":true,"aside":true,"toc":true,"header":true,"bottom":true,"layout":"default","body":{"type":"root","children":[{"type":"element","tag":"h1","props":{"id":"how-to-contribute-to-porkyproductions"},"children":[{"type":"text","value":"How to contribute to PorkyProductions"}]},{"type":"element","tag":"h2","props":{"id":"in-4-easy-steps"},"children":[{"type":"text","value":"In 4 Easy Steps"}]},{"type":"element","tag":"h3","props":{"id":"step-1-think"},"children":[{"type":"text","value":"Step 1: Think"}]},{"type":"element","tag":"p","props":{},"children":[{"type":"text","value":"We are an open source project, but most of the development is handled by PorkyProductions. You can still contribute, but be aware that most development is handled by PorkyProductions."}]},{"type":"element","tag":"h3","props":{"id":"step-2-decide-what-the-problem-is"},"children":[{"type":"text","value":"Step 2: Decide what the problem is"}]},{"type":"element","tag":"h4","props":{"id":"did-you-find-a-bug"},"children":[{"type":"element","tag":"strong","props":{},"children":[{"type":"text","value":"Did you find a bug?"}]}]},{"type":"element","tag":"ul","props":{},"children":[{"type":"element","tag":"li","props":{},"children":[{"type":"element","tag":"strong","props":{},"children":[{"type":"text","value":"Do not open up a GitHub issue if the bug is a security vulnerability"}]},{"type":"text","value":", and instead to refer to our Communtiy Guidelines for contact info."}]},{"type":"element","tag":"li","props":{},"children":[{"type":"element","tag":"strong","props":{},"children":[{"type":"text","value":"Ensure the bug was not already reported"}]},{"type":"text","value":" by searching on GitHub under "},{"type":"element","tag":"a","props":{"href":"https://github.com/PorkyProductions/UA-detect/issues","rel":["nofollow"]},"children":[{"typ